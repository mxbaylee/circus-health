{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": [
    "src/server/runtime-json.d.ts",
    "src/scripts/**/*.ts",
    "src/tests/fixtures/**/*.ts",
    "scripts/**/*.ts",
    "deploy/**/*.ts",
    "commitlint.config.ts",
    "vitest.config.ts"
  ]
}
