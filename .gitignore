.DS_Store
__pycache__/
*.pyc
.downloads/
*.part
node_modules/
dist/
*.tsbuildinfo

# Local configuration and credentials, at any depth. Commit templates only.
*.env
.env
.env.*
!.env.example
!.env.sample
proxy-key
auth.json
credentials.json
*.key
*.pem
*.p12
*.pfx
*.keystore
*recovery*.json

# Runtime databases and raw logs are local evidence, never source inputs.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.sqlite-journal
*.sqlite3-journal
*.log

# Private runtime state and accidental local copies must stay untracked.
/data/
/config/
/local-data/
/state/
/runtime/
/credentials/
/secrets/
/backups/
/uploads/
/evidence/
/validation/
/test-results/
/playwright-report/
/work-notes/
/*-work-notes/

# Agent-local session state and historical execution ledgers.
/.claude/
/.codex/
/.superpowers/

# Husky-generated hook launchers.
/.husky/_/
